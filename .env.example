# ──────────────────────────────────────────────────────────────
# ──────────────────────────────────────────────────────────────
# Brevo SMTP credentials (like Rent Collector)
# ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_email@smtp-brevo.com
SMTP_PASS=your_brevo_smtp_password

# The "From" address that appears in every outgoing email.
# IMPORTANT: This MUST be an email address verified in your Brevo account,
# otherwise Brevo will silently drop or reject your emails!
# (e.g. safihamza395@gmail.com)
MAIL_FROM=safihamza395@gmail.com
